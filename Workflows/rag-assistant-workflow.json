      ],
      "id": "8cad321b-157e-47c6-bce5-4e75a054b4b0",
      "name": "Simple Memory",
      "notes": "Session keyed per Telegram chat so conversations stay separated."
    },
    {
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolDescription": "Berisi Manual SOP Proyek PT Bumi Trasa Infrastruktur: prosedur K3, APD per zona kerja, kerja di ketinggian, pengoperasian alat berat, spesifikasi mutu beton dan material, prosedur pengecoran, pemadatan tanah, administrasi proyek, dan tanggap darurat.",
        "tableName": {
